  m_Script: {fileID: 11500000, guid: 22d0308a90dc49ae97395f1b651723b5, type: 3}
  m_Name: Q_CTX_02_VendorFatigue
  m_EditorClassIdentifier:
  questionId: CTX-02
  category: 0
  speakerName: Hiring Manager
  questionText: >-
    The champion starts the meeting by saying, 'We have had three vendors tell us the same thing.' What do you do first?
  answerOptions:
  - {fileID: 11400001}
  - {fileID: 11400002}
  - {fileID: 11400003}
  - {fileID: 11400004}
--- !u!114 &11400001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_02_A1
  answerText: >-
    Ask what felt repetitive or unhelpful, then use that to narrow the conversation.
  technicalDelta: 1
  commercialDelta: 2
  rapportDelta: 3
  energyDelta: 0
--- !u!114 &11400002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_02_A2
  answerText: >-
    Acknowledge the fatigue and give a concise overview anyway so everyone has baseline context.
  technicalDelta: 1
  commercialDelta: 0
  rapportDelta: 1
  energyDelta: 0
--- !u!114 &11400003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_02_A3
  answerText: >-
    Move directly into a differentiated feature demo.
  technicalDelta: 1
  commercialDelta: 0
  rapportDelta: -1
  energyDelta: 1
--- !u!114 &11400004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_02_A4
  answerText: >-
    Ask who is most skeptical in the room and what would make the meeting worth their time.
  technicalDelta: 0
  commercialDelta: 2
  rapportDelta: 3
  energyDelta: 0
