  m_Name: Q_CTX_01_BoardRiskDiscovery
  m_EditorClassIdentifier:
  questionId: CTX-01
  category: 0
  speakerName: Hiring Manager
  questionText: >-
    A customer says their board wants measurable cyber risk reduction this quarter, but the security team only wants to discuss tooling. How do you open discovery?
  answerOptions:
  - {fileID: 11400001}
  - {fileID: 11400002}
  - {fileID: 11400003}
  - {fileID: 11400004}
--- !u!114 &11400001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_01_A1
  m_EditorClassIdentifier:
  answerText: >-
    Start with the board metric, then ask what control failures or audit findings are driving urgency.
  technicalDelta: 2
  commercialDelta: 2
  rapportDelta: 1
  energyDelta: 1
--- !u!114 &11400002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_01_A2
  m_EditorClassIdentifier:
  answerText: >-
    Ask for their current tooling list so you can map the fastest demo path.
  technicalDelta: 1
  commercialDelta: 0
  rapportDelta: 0
  energyDelta: 1
--- !u!114 &11400003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_01_A3
  m_EditorClassIdentifier:
  answerText: >-
    Explain that cyber risk is hard to quantify and suggest a platform overview first.
  technicalDelta: 0
  commercialDelta: -1
  rapportDelta: -1
  energyDelta: -1
