%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22d0308a90dc49ae97395f1b651723b5, type: 3}
  m_Name: Q_TECH_06_ProductLimitations
  questionId: TECH-06
  category: 1
  speakerName: Principal Security Architect
  questionText: >-
    The architect asks whether the platform can fully cover an unsupported legacy protocol they still run in production. It cannot today. How do you handle it?
  answerOptions:
  - {fileID: 11400001}
  - {fileID: 11400002}
  - {fileID: 11400003}
  - {fileID: 11400004}
--- !u!114 &11400001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_TECH_06_A1
  answerText: >-
    State the limitation clearly, explain adjacent telemetry options, and define what would remain uncovered.
  technicalDelta: 3
  commercialDelta: 0
  rapportDelta: 2
  energyDelta: -1
--- !u!114 &11400002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_TECH_06_A2
  answerText: >-
    Say it is on the roadmap and focus on the parts of the environment you can cover now.
  technicalDelta: 0
  commercialDelta: 1
  rapportDelta: 0
  energyDelta: 0
--- !u!114 &11400003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_TECH_06_A3
  answerText: >-
    Ask whether the protocol is actually material to their risk before deciding how much time to spend on it.
  technicalDelta: 1
  commercialDelta: 2
  rapportDelta: 0
  energyDelta: -1
--- !u!114 &11400004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_TECH_06_A4
  answerText: >-
    Avoid the limitation for now and offer a follow-up with product management.
  technicalDelta: -2
  commercialDelta: 0
  rapportDelta: -1
  energyDelta: -1
