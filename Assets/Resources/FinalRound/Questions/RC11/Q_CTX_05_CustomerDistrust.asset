%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22d0308a90dc49ae97395f1b651723b5, type: 3}
  m_Name: Q_CTX_05_CustomerDistrust
  questionId: CTX-05
  category: 0
  speakerName: Hiring Manager
  questionText: >-
    The customer says every vendor claims measurable risk reduction and none of them can prove it. How do you respond without sounding like vendor number four?
  answerOptions:
  - {fileID: 11400001}
  - {fileID: 11400002}
  - {fileID: 11400003}
  - {fileID: 11400004}
--- !u!114 &11400001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_05_A1
  answerText: >-
    Acknowledge the fatigue, then ask which claim would be most valuable to disprove in a proof workshop.
  technicalDelta: 1
  commercialDelta: 1
  rapportDelta: 2
  energyDelta: 0
--- !u!114 &11400002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_05_A2
  answerText: >-
    Walk through the product architecture in detail so they can see the claim is technically credible.
  technicalDelta: 3
  commercialDelta: -1
  rapportDelta: -1
  energyDelta: -1
--- !u!114 &11400003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_05_A3
  answerText: >-
    Say you understand completely and offer to send customer references after the call.
  technicalDelta: -1
  commercialDelta: 1
  rapportDelta: 1
  energyDelta: -1
--- !u!114 &11400004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d521c6b84db4b8fae30e3785d9e9582, type: 3}
  m_Name: Q_CTX_05_A4
  answerText: >-
    Define a narrow before-and-after metric with their data owner and agree what would count as a failed proof.
  technicalDelta: 2
  commercialDelta: 2
  rapportDelta: 0
  energyDelta: -1
